@Api_HostAddress = http://localhost:5046

POST {{Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "privateEmail": "student.personal@example.com",
  "username": "studybuddy",
  "fullName": "Taylor Student",
  "password": "Pa55word!",
  "schoolEmail": "taylor@student.school.edu"
}

###

POST {{Api_HostAddress}}/api/auth/verify-account
Content-Type: application/json
Accept: application/json

{
  "schoolEmail": "taylor@student.school.edu",
  "code": "123456"
}

###

POST {{Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "usernameOrPrivateEmail": "studybuddy",
  "password": "Pa55word!"
}

###

POST {{Api_HostAddress}}/api/auth/refresh
Accept: application/json

###

POST {{Api_HostAddress}}/api/auth/logout
