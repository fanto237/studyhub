@Api_HostAddress = http://localhost:5046

POST {{Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "privateEmail": "student.personal@example.com",
  "username": "studybuddy",
  "fullName": "Taylor Student",
  "password": "Pa55word!",
  "schoolEmail": "taylor@student.school.edu"
}

###

POST {{Api_HostAddress}}/api/auth/verify-account
Content-Type: application/json
Accept: application/json

{
  "schoolEmail": "taylor@student.school.edu",
  "code": "123456"
}

###

POST {{Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "usernameOrPrivateEmail": "studybuddy",
  "password": "Pa55word!"
}

###

POST {{Api_HostAddress}}/api/auth/refresh
Accept: application/json

###

POST {{Api_HostAddress}}/api/auth/logout
Accept: application/json

###

POST {{Api_HostAddress}}/api/posts
Content-Type: multipart/form-data; boundary=StudyHubBoundary
Accept: application/json

--StudyHubBoundary
Content-Disposition: form-data; name="title"

Calculus I Final Exam 2024
--StudyHubBoundary
Content-Disposition: form-data; name="description"

Past final exam with integrals and limits.
--StudyHubBoundary
Content-Disposition: form-data; name="tags"

calculus
--StudyHubBoundary
Content-Disposition: form-data; name="tags"

final-exam
--StudyHubBoundary
Content-Disposition: form-data; name="file"; filename="calculus-final.pdf"
Content-Type: application/pdf

< ./sample-data/calculus-final.pdf
--StudyHubBoundary--

###

POST {{Api_HostAddress}}/api/posts/00000000-0000-0000-0000-000000000000/vote
Content-Type: application/json
Accept: application/json

{
  "vote": "up"
}

###

POST {{Api_HostAddress}}/api/posts/00000000-0000-0000-0000-000000000000/vote
Content-Type: application/json
Accept: application/json

{
  "vote": "down"
}

###

POST {{Api_HostAddress}}/api/posts/00000000-0000-0000-0000-000000000000/vote
Content-Type: application/json
Accept: application/json

{
  "vote": "remove"
}

